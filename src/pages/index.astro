---
// The landing page ("flight chart" direction). The docs live under Starlight (src/content/docs); this page has its own layout.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = (slug: string) => `${base}/${slug}/`;

// The Testpilot mark, on its 48-unit grid (same drawing as the app's Logo.tsx).
const TICK = 'M5 26.5 L10 21.5 L17.5 29 L30.6 16 L32.3 17.7 L19 35 Z';
const JET =
	'M10.5 0 C10.5 -0.8 9.5 -1.4 8 -1.4 L2.5 -1.4 L-3 -10.5 L-5.8 -10.5 L-2.4 -1.4 L-7.6 -1.4 L-9.6 -4.8 L-11.4 -4.8 L-10.2 -0.6 L-10.2 0.6 L-11.4 4.8 L-9.6 4.8 L-7.6 1.4 L-2.4 1.4 L-5.8 10.5 L-3 10.5 L2.5 1.4 L8 1.4 C9.5 1.4 10.5 0.8 10.5 0 Z';
const JET_AT_REST = 'translate(39.2 9.2) rotate(-45) scale(0.74)';
const MARK_VIEWBOX = '3.5 -3.6 44 44';

const legs = [
	{ n: '1', route: 'WORDS → AGENT', title: 'Describe', text: 'Tell the agent what to check, in plain words, the way you would brief a colleague.', ai: 'AI · ON', on: true },
	{ n: '2', route: 'AGENT → STEPS', title: 'Fly', text: 'The agent drives a real browser and saves every action as a step, with a screenshot.', ai: 'AI · ON, THEN SAVED', on: true },
	{ n: '3', route: 'STEPS → RUNS', title: 'Autopilot', text: 'Every run after that replays the saved steps. No AI, no cost, the same answer every time.', ai: 'AI · OFF', on: false },
];

// The management side: what the app keeps for you once tests exist (Repository, Shared steps, Runs, Overview, ...).
const stations = [
	{ code: 'TWR 01', title: 'Repository', text: 'Every test in a tree of suites. Drag suites to reorganise, give each test a priority, severity and tags, and filter by state, platform or last result.' },
	{ code: 'TWR 02', title: 'Manual and automated, side by side', text: 'Write manual steps for what a person checks, then press Automate with AI when it is ready. Web and Windows tests share one repository.' },
	{ code: 'TWR 03', title: 'Shared steps', text: 'Reusable groups of steps, like signing in. Write them once and insert them into any test.' },
	{ code: 'TWR 04', title: 'Runs', text: 'Run one test, a selection or the whole suite against any environment. Live progress, Stop, and Re-run failed.' },
	{ code: 'TWR 05', title: 'Overview and history', text: 'Passed, failed and not run at a glance, per environment, over 7 or 30 days. Every test keeps its own run history.' },
	{ code: 'TWR 06', title: 'Team and admin', text: 'Projects, members and an activity feed of who changed what. Admins manage users, workers and test machines.' },
];

const boardTiles = [
	{ label: 'Tests', n: '128', cls: '' },
	{ label: 'Passed', n: '109', cls: 'pass' },
	{ label: 'Failed', n: '6', cls: 'fail' },
	{ label: 'Not run', n: '13', cls: 'idle' },
];

const boardTests = [
	{ suite: 'Checkout' },
	{ name: 'Pay with a saved card', state: 'AUTO', pri: 'P1', result: 'pass' },
	{ name: 'Apply a discount code', state: 'AUTO', pri: 'P2', result: 'fail' },
	{ name: 'Refund by phone', state: 'MANUAL', pri: 'P3', result: 'idle' },
	{ suite: 'Sign in' },
	{ name: 'Sign in with SSO', state: 'AUTO', pri: 'P1', result: 'pass' },
];

const rows = [
	{ label: 'Quick to write', v: [false, true] },
	{ label: 'Free to run', v: [true, false] },
	{ label: 'Same result every time', v: [true, false] },
	{ label: 'Copes when the page changes', v: [false, true] },
	{ label: 'You approve every change', v: [true, false] },
];

const notices = [
	{ code: 'NOTAM 01', title: "Chat, don't code", text: 'No selectors, no scripts. You review the steps the agent saved.' },
	{ code: 'NOTAM 02', title: 'Free, repeatable runs', text: 'Runs replay saved steps, so they cost nothing and give the same answer twice.' },
	{ code: 'NOTAM 03', title: 'Self-healing, with you in charge', text: 'When the page changes, the agent proposes a fix. Nothing changes until you accept it.' },
	{ code: 'NOTAM 04', title: 'Every step on camera', text: 'Pass or fail, every step keeps a screenshot, so a failure explains itself.' },
	{ code: 'NOTAM 05', title: 'Secrets stay secret', text: 'Passwords are filled in at run time. The AI sees variable names, never values.' },
	{ code: 'NOTAM 06', title: 'Cloud or your machine', text: 'Run in cloud browsers, or in a visible browser on your own machine with Testpilot Desktop.' },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Testpilot · Describe the test. Testpilot flies it.</title>
		<meta
			name="description"
			content="Test management with an AI agent built in. Describe a test in plain words, then organise, run and track every test in one place. Runs replay on autopilot: no AI, no cost, the same answer every time."
		/>
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,600&family=IBM+Plex+Mono:wght@400;500;600&family=Caveat:wght@600&family=Geist:wght@400;500;600&display=swap"
		/>
	</head>
	<body>
		<header class="top">
			<a class="brand" href={`${base}/`} aria-label="Testpilot home">
				<svg viewBox={MARK_VIEWBOX} width="30" height="30" aria-hidden="true">
					<path d={TICK} class="ink-fill" />
					<path d={JET} class="mag-fill" transform={JET_AT_REST} />
				</svg>
				<span>Testpilot</span>
			</a>
			<nav aria-label="Main">
				<a href="#route">Route</a>
				<a href="#plan">Flight plan</a>
				<a href="#tower">Control tower</a>
				<a href={docs('how-it-works')}>Docs</a>
				<a class="btn btn-ink" href={docs('getting-started')}>File a flight plan →</a>
			</nav>
		</header>

		<main>
			<!-- Hero: the route chart -->
			<section class="hero" id="route">
				<div class="hero-copy">
					<p class="label rise" style="--d: 0.05s">CHART TP-1 · FOR TESTING PURPOSES</p>
					<h1 class="rise" style="--d: 0.15s">Describe the test.<br /><em>Testpilot flies it.</em></h1>
					<p class="lede rise" style="--d: 0.3s">
						Testpilot is where your team keeps, runs and tracks its tests. To write one, describe it: an AI agent plots the route
						from your plain words, and every run after that follows it on autopilot. No AI, no cost, the same answer every time.
					</p>
					<div class="cta rise" style="--d: 0.45s">
						<a class="btn btn-mag" href={docs('getting-started')}>Get started →</a>
						<a class="btn btn-line" href="#plan">Read the flight plan</a>
					</div>
				</div>

				<figure class="chart rise" style="--d: 0.2s">
					<svg viewBox="0 0 640 500" role="img" aria-label="Route chart: from your words, to the agent, to saved steps, to runs. AI only on the first legs.">
						<g class="grid">
							<line x1="0" y1="100" x2="640" y2="100"></line><line x1="0" y1="200" x2="640" y2="200"></line><line x1="0" y1="300" x2="640" y2="300"></line><line x1="0" y1="400" x2="640" y2="400"></line>
							<line x1="128" y1="0" x2="128" y2="500"></line><line x1="256" y1="0" x2="256" y2="500"></line><line x1="384" y1="0" x2="384" y2="500"></line><line x1="512" y1="0" x2="512" y2="500"></line>
						</g>
						<g class="coords">
							<text x="6" y="96">N52°</text><text x="6" y="196">N51°</text><text x="6" y="296">N50°</text><text x="6" y="396">N49°</text>
							<text x="132" y="492">E14°</text><text x="260" y="492">E15°</text><text x="388" y="492">E16°</text><text x="516" y="492">E17°</text>
						</g>
						<g class="terrain">
							<path d="M 60 420 C 90 350, 190 360, 210 410 S 160 480, 60 420 Z"></path>
							<path d="M 75 418 C 100 370, 175 378, 190 410 S 150 462, 75 418 Z"></path>
							<path d="M 430 90 C 500 40, 600 70, 590 140 S 470 190, 430 90 Z"></path>
							<path d="M 455 100 C 510 64, 580 86, 570 136 S 485 165, 455 100 Z"></path>
						</g>
						<circle cx="370" cy="250" r="120" class="airspace"></circle>
						<text x="300" y="138" class="airspace-label">CLASS AP · NO AI BELOW FL0</text>
						<g transform="translate(560 410)" class="rose">
							<circle r="46" class="rose-ring"></circle>
							<circle r="38" class="rose-dots"></circle>
							<path d="M0 -46 L5 -6 L0 0 L-5 -6 Z" class="mag-fill"></path>
							<path d="M0 46 L5 6 L0 0 L-5 6 Z" class="ink-fill"></path>
							<text x="-4" y="-52" class="rose-n">N</text>
						</g>

						<path id="chart-route" d="M 70 130 L 210 250 L 360 210 L 520 330" class="route"></path>
						<circle cx="70" cy="130" r="9" class="ring"></circle>
						<g transform="translate(70 130)"><path d="M -11 0 L -5.5 -9.5 L 5.5 -9.5 L 11 0 L 5.5 9.5 L -5.5 9.5 Z" class="wp"></path><circle r="2.5" class="ink-fill"></circle></g>
						<g transform="translate(210 250)"><path d="M 0 -11 L 10 7 L -10 7 Z" class="wp"></path></g>
						<g transform="translate(360 210)"><circle r="9" class="wp"></circle><circle r="3" class="ink-fill"></circle></g>
						<g transform="translate(520 330)" class="airport">
							<circle r="16" class="airport-halo"></circle>
							<circle r="11" class="airport-ring"></circle>
							<line x1="-7" y1="-6" x2="7" y2="6"></line><line x1="-7" y1="6" x2="7" y2="-6"></line>
						</g>
						<g class="wp-name"><text x="88" y="126">WORDS</text><text x="184" y="282">AGENT</text><text x="336" y="190">STEPS</text><text x="540" y="320">RUNS</text></g>
						<g class="wp-note"><text x="88" y="140">you, plain words</text><text x="182" y="296">drives a browser</text><text x="320" y="176">saved, with screenshots</text><text x="540" y="334">daily, no AI</text></g>
						<g class="leg-label">
							<text x="118" y="210" transform="rotate(40 118 210)" class="mag">AI ON</text>
							<text x="262" y="222" transform="rotate(-15 262 222)" class="mag">SAVE</text>
							<text x="405" y="262" transform="rotate(37 405 262)" class="blue">AUTOPILOT</text>
						</g>

						<g class="plane">
							<animateMotion dur="9s" repeatCount="indefinite" rotate="auto" keyPoints="0;0.32;0.6;1;1" keyTimes="0;0.3;0.5;0.85;1" calcMode="linear">
								<mpath href="#chart-route"></mpath>
							</animateMotion>
							<g transform="scale(1.25)"><path d={JET}></path></g>
						</g>

						<path class="ink-draw" d="M 214 70 C 180 80, 150 110, 132 172"></path>
						<path class="ink-draw" d="M 124 160 L 132 174 L 142 162"></path>
						<text class="note" x="218" y="64">AI only on this leg!</text>
					</svg>
					<figcaption>SCALE 1 : 1 TEST · NOT FOR NAVIGATION</figcaption>
				</figure>
			</section>

			<!-- The flight plan: three legs -->
			<section class="block" id="plan" data-reveal>
				<div class="block-head">
					<h2>The flight plan</h2>
					<span class="label">FORM TP · THREE LEGS</span>
				</div>
				<div class="legs">
					{
						legs.map((l, i) => (
							<article class="leg" style={`--d: ${0.15 + i * 0.18}s`}>
								<div class="leg-top">
									<span>LEG {l.n}</span>
									<span>{l.route}</span>
								</div>
								<h3>{l.title}</h3>
								<p>{l.text}</p>
								<p class={l.on ? 'ai mag' : 'ai blue'}>{l.ai}</p>
							</article>
						))
					}
					<div class="stamp" aria-hidden="true">CLEARED · NO AI EN ROUTE</div>
				</div>
			</section>

			<!-- Control tower: test management, once the tests exist -->
			<section class="block" id="tower" data-reveal>
				<div class="block-head">
					<h2>And a control tower for every test</h2>
					<span class="label">TWR · TEST MANAGEMENT</span>
				</div>
				<p class="block-lede">
					Chatting writes a test. Testpilot also keeps it: organised in suites, run against any environment, tracked over time and
					shared with your team.
				</p>
				<div class="tower">
					<figure class="board" aria-label="Example: a project overview with its tests">
						<div class="board-top">
							<span>OVERVIEW · SHOP</span>
							<span class="board-chip">staging · 7 days</span>
						</div>
						<div class="board-tiles">
							{
								boardTiles.map((t) => (
									<div class={`board-tile ${t.cls}`}>
										<span>{t.label}</span>
										<strong>{t.n}</strong>
									</div>
								))
							}
						</div>
						<div class="board-bar" aria-hidden="true">
							<i class="pass" style="flex: 109"></i><i class="fail" style="flex: 6"></i><i class="idle" style="flex: 13"></i>
						</div>
						<ul class="board-tree">
							{
								boardTests.map((t) =>
									t.suite ? (
										<li class="board-suite">▾ {t.suite}</li>
									) : (
										<li class="board-test">
											<span class={`dot ${t.result}`} aria-hidden="true" />
											<span class="board-name">{t.name}</span>
											<span class="board-tag">{t.state}</span>
											<span class="board-tag">{t.pri}</span>
										</li>
									),
								)
							}
						</ul>
						<p class="board-feed">↳ new locator accepted · Apply a discount code · 2m</p>
					</figure>
					<div class="stations">
						{
							stations.map((s, i) => (
								<article class="notice" style={`--d: ${(i % 2) * 0.1 + Math.floor(i / 2) * 0.08}s`}>
									<span class="notice-code">{s.code}</span>
									<h3>{s.title}</h3>
									<p>{s.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<!-- Comparison as the chart legend -->
			<section class="block" data-reveal>
				<div class="block-head">
					<h2>AI where it helps, not on every run</h2>
					<span class="label">CHART LEGEND</span>
				</div>
				<div class="table-wrap">
					<table class="legend">
						<thead>
							<tr>
								<th><span class="sr">Criterion</span></th>
								<th>Hand-written scripts</th>
								<th>AI on every step</th>
								<th class="win">Testpilot</th>
							</tr>
						</thead>
						<tbody>
							{
								rows.map((r, i) => (
									<tr>
										<td>{r.label}</td>
										{r.v.map((ok) => (
											<td class={ok ? 'hand yes' : 'hand no'}>{ok ? '✓ yes' : '✗ no'}</td>
										))}
										<td class="win">
											<svg class="tick" viewBox="3 14 32 24" width="30" height="24" role="img" aria-label="Yes" style={`--d: ${0.2 + i * 0.12}s`}>
												<path d={TICK} />
											</svg>
										</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</section>

			<!-- Notices to testers: the features -->
			<section class="block" id="notices" data-reveal>
				<div class="block-head">
					<h2>Notices to testers</h2>
					<span class="label">NOTAMS · IN FORCE</span>
				</div>
				<div class="notices">
					{
						notices.map((n, i) => (
							<article class="notice" style={`--d: ${(i % 2) * 0.1 + Math.floor(i / 2) * 0.08}s`}>
								<span class="notice-code">{n.code}</span>
								<h3>{n.title}</h3>
								<p>{n.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<!-- Call to action -->
			<section class="block final-wrap" data-reveal>
				<div class="final">
					<div>
						<p class="hand-note">your route starts here ↓</p>
						<h2>File your first flight plan.</h2>
						<p class="final-text">Run Testpilot on your machine in minutes, then plot your first test by chatting.</p>
					</div>
					<div class="final-actions">
						<a class="btn btn-mag btn-big" href={docs('getting-started')}>Get started →</a>
						<a class="btn btn-line" href={docs('test-machine-setup')}>Set up a test machine</a>
					</div>
				</div>
			</section>
		</main>

		<footer class="foot">
			<a class="brand" href={`${base}/`}>
				<svg viewBox={MARK_VIEWBOX} width="24" height="24" aria-hidden="true">
					<path d={TICK} class="ink-fill" />
					<path d={JET} class="mag-fill" transform={JET_AT_REST} />
				</svg>
				<span>Testpilot</span>
			</a>
			<nav aria-label="Documentation">
				<a href={docs('how-it-works')}>How it works</a>
				<a href={docs('getting-started')}>Getting started</a>
				<a href={docs('using-testpilot')}>Using Testpilot</a>
				<a href={docs('test-machine-setup')}>Test machine setup</a>
			</nav>
		</footer>

		<script>
			// Sections reveal (and their stamps and ticks play) once they scroll into view.
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
			if (reduce || !('IntersectionObserver' in window)) {
				items.forEach((el) => el.classList.add('in'));
			} else {
				const io = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (!e.isIntersecting) continue;
							(e.target as HTMLElement).classList.add('in');
							io.unobserve(e.target);
						}
					},
					{ threshold: 0.2 },
				);
				items.forEach((el) => io.observe(el));
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--paper: #f3eee2;
		--paper-2: #f8f4ea;
		--ink: #1f2b45;
		--ink-2: #45506a;
		--muted: #8a8270;
		--rule: #b3a888;
		--grid: #d9cfb7;
		--mag: #b8336a;
		--mag-dark: #8f2552;
		--blue: #2f6db5;
		color-scheme: light;
	}
	* {
		box-sizing: border-box;
	}
	html {
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		color: var(--ink);
		font-family: Geist, system-ui, sans-serif;
		background-color: var(--paper);
		background-image: radial-gradient(rgba(31, 43, 69, 0.07) 1px, transparent 1px);
		background-size: 22px 22px;
		-webkit-font-smoothing: antialiased;
		overflow-x: hidden;
	}
	a {
		color: inherit;
	}
	.ink-fill {
		fill: var(--ink);
	}
	.mag-fill {
		fill: var(--mag);
	}
	.label {
		margin: 0;
		font-family: 'IBM Plex Mono', monospace;
		font-size: 13px;
		letter-spacing: 0.12em;
		color: var(--mag);
	}
	.sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
	}

	/* Header */
	.top {
		max-width: 1240px;
		margin: 0 auto;
		padding: 22px 24px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
		border-bottom: 1.5px solid var(--ink);
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		font-family: Fraunces, serif;
		font-weight: 600;
		font-size: 24px;
	}
	.top nav {
		display: flex;
		align-items: center;
		gap: 24px;
		font-family: 'IBM Plex Mono', monospace;
		font-size: 13.5px;
	}
	.top nav a:not(.btn) {
		text-decoration: none;
		background: linear-gradient(var(--mag), var(--mag)) 0 100% / 0 1.5px no-repeat;
		transition: background-size 0.25s;
	}
	.top nav a:not(.btn):hover {
		background-size: 100% 1.5px;
	}

	/* Buttons */
	.btn {
		display: inline-flex;
		align-items: center;
		height: 50px;
		padding: 0 22px;
		border-radius: 3px;
		font-family: 'IBM Plex Mono', monospace;
		font-weight: 600;
		font-size: 15px;
		text-decoration: none;
		transition: transform 0.15s, box-shadow 0.15s, background 0.15s;
	}
	.btn-ink {
		height: 38px;
		padding: 0 16px;
		background: var(--ink);
		color: var(--paper);
		font-size: 13.5px;
	}
	.btn-mag {
		background: var(--mag);
		color: #fff;
		box-shadow: 3px 3px 0 var(--ink);
	}
	.btn-mag:hover {
		transform: translate(-2px, -2px);
		box-shadow: 5px 5px 0 var(--ink);
	}
	.btn-line {
		border: 1.5px solid var(--ink);
		font-weight: 500;
	}
	.btn-line:hover {
		background: rgba(31, 43, 69, 0.06);
	}
	.btn-big {
		height: 58px;
		font-size: 17px;
		box-shadow: 4px 4px 0 var(--ink);
	}

	/* Hero */
	.hero {
		max-width: 1240px;
		margin: 0 auto;
		padding: 56px 24px 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 44px;
	}
	.hero-copy {
		flex: 1 1 500px;
		min-width: 0;
	}
	h1 {
		margin: 18px 0 0;
		font-family: Fraunces, serif;
		font-weight: 600;
		font-size: clamp(44px, 5vw, 70px);
		line-height: 1;
