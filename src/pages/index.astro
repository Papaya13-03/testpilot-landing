---
// The landing page. The docs live under Starlight (src/content/docs); this page has its own layout.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = (slug: string) => `${base}/${slug}/`;

// The Testpilot mark, on its 48-unit grid (same drawing as the app's Logo.tsx).
const TICK = 'M5 26.5 L10 21.5 L17.5 29 L30.6 16 L32.3 17.7 L19 35 Z';
const JET =
	'M10.5 0 C10.5 -0.8 9.5 -1.4 8 -1.4 L2.5 -1.4 L-3 -10.5 L-5.8 -10.5 L-2.4 -1.4 L-7.6 -1.4 L-9.6 -4.8 L-11.4 -4.8 L-10.2 -0.6 L-10.2 0.6 L-11.4 4.8 L-9.6 4.8 L-7.6 1.4 L-2.4 1.4 L-5.8 10.5 L-3 10.5 L2.5 1.4 L8 1.4 C9.5 1.4 10.5 0.8 10.5 0 Z';
const JET_AT_REST = 'translate(39.2 9.2) rotate(-45) scale(0.74)';
const MARK_VIEWBOX = '3.5 -3.6 44 44';

const steps = [
	{ n: '01', title: 'Describe', text: 'Tell the agent what to check, in plain words. Like briefing a colleague.' },
	{ n: '02', title: 'Fly', text: 'The agent drives a real browser and saves every action as a step, with a screenshot.' },
	{ n: '03', title: 'Autopilot', text: 'Every run after that replays the saved steps. No AI, no cost, the same answer every time.' },
];

const rows = [
	{ label: 'Quick to write', v: [false, true, true] },
	{ label: 'Free to run', v: [true, false, true] },
	{ label: 'Same result every time', v: [true, false, true] },
	{ label: 'Copes when the page changes', v: [false, true, true] },
	{ label: 'You approve every change', v: [true, false, true] },
];

// 24-unit stroke icons.
const icons: Record<string, string> = {
	chat: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
	loop: '<path d="M21 12a9 9 0 1 1-2.64-6.36L21 8"/><path d="M21 3v5h-5"/>',
	wrench:
		'<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
	camera:
		'<path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/>',
	lock: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
	monitor: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
};
const features = [
	{ icon: 'chat', title: "Chat, don't code", text: 'No selectors, no scripts. You review the steps the agent saved.' },
	{ icon: 'loop', title: 'Free, repeatable runs', text: 'Runs replay saved steps, so they cost nothing and give the same answer twice.' },
	{ icon: 'wrench', title: 'Self-healing, with you in charge', text: 'When the page changes, the agent proposes a fix. Nothing changes until you accept it.' },
	{ icon: 'camera', title: 'Every step on camera', text: 'Pass or fail, every step keeps a screenshot, so a failure explains itself.' },
	{ icon: 'lock', title: 'Secrets stay secret', text: 'Passwords are filled in at run time. The AI sees variable names, never values.' },
	{ icon: 'monitor', title: 'Cloud or your machine', text: 'Run in cloud browsers, or in a visible browser on your own machine with Testpilot Desktop.' },
];

// "How it flies" diagram: boxes and the flight paths between them (900 x 300).
const flights = [
	{ id: 'f1', d: 'M166 150 L236 150', delay: 0 },
	{ id: 'f2', d: 'M478 128 L560 95', delay: 0.6 },
	{ id: 'f3', d: 'M478 172 L560 205', delay: 0.9 },
	{ id: 'f4', d: 'M742 95 L786 138', delay: 1.5 },
	{ id: 'f5', d: 'M742 205 L786 162', delay: 1.8 },
];
const boxes = [
	{ x: 20, y: 110, w: 140, h: 80, title: 'You', sub: 'describe the test' },
	{ x: 566, y: 58, w: 170, h: 74, title: 'Cloud browsers', sub: 'Playwright workers' },
	{ x: 566, y: 168, w: 170, h: 74, title: 'Testpilot Desktop', sub: 'your machine' },
	{ x: 792, y: 110, w: 96, h: 80, title: 'Your app', sub: 'under test' },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Testpilot · Describe the test. Testpilot flies it.</title>
		<meta name="description" content="An AI agent turns plain words into automated web tests. Every run after that replays on autopilot: no AI, no cost, the same answer every time." />
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" />
	</head>
	<body>
		<header class="nav">
			<a class="brand" href={`${base}/`} aria-label="Testpilot home">
				<svg viewBox={MARK_VIEWBOX} width="28" height="28" aria-hidden="true">
					<path d={TICK} class="m-tick" />
					<path d={JET} class="m-jet" transform={JET_AT_REST} />
				</svg>
				<span>Testpilot</span>
			</a>
			<nav aria-label="Main">
				<a href="#how">How it flies</a>
				<a href="#why">Why Testpilot</a>
				<a href={docs('how-it-works')}>Docs</a>
				<a class="btn btn-small" href={docs('getting-started')}>Get started</a>
			</nav>
		</header>

		<main>
			<!-- Hero -->
			<section class="hero">
				<div class="hero-grid" aria-hidden="true"></div>
				<div class="hero-glow" aria-hidden="true"></div>
				<svg class="sky" viewBox="0 0 1440 720" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
					<path id="sky-route" class="sky-trail" d="M -120 640 C 260 600, 480 380, 760 430 S 1180 250, 1580 110" />
					<g class="sky-jet">
						<animateMotion dur="16s" repeatCount="indefinite" rotate="auto" keyPoints="0;1" keyTimes="0;1" calcMode="linear">
							<mpath href="#sky-route" />
						</animateMotion>
						<g transform="scale(1.3)"><path d={JET} /></g>
					</g>
				</svg>

				<div class="hero-inner">
					<svg class="hero-mark" viewBox={MARK_VIEWBOX} width="168" height="168" role="img" aria-label="Testpilot logo">
						<defs>
							<mask id="hero-trail" maskUnits="userSpaceOnUse" x="0" y="0" width="48" height="48">
								<path class="h-trail" d="M5.5 23.5 L18.3 32.5 L33 15.5" />
							</mask>
						</defs>
						<path d={TICK} class="m-tick" mask="url(#hero-trail)" />
						<path d={JET} class="m-jet h-jet" transform={JET_AT_REST} />
					</svg>
					<p class="eyebrow rise" style="--d: 0.9s">AI writes the test · Runs need no AI</p>
					<h1 class="rise" style="--d: 1.05s">Describe the test.<br /><span class="shine">Testpilot flies it.</span></h1>
					<p class="lede rise" style="--d: 1.2s">
						An AI agent turns plain words into automated web tests. Every run after that replays on autopilot: no AI, no cost, the
						same answer every time.
					</p>
					<div class="cta rise" style="--d: 1.35s">
						<a class="btn btn-primary takeoff" href={docs('getting-started')}>
							Get started
							<svg viewBox="-12 -12 24 24" width="18" height="18" aria-hidden="true"><path d={JET} /></svg>
						</a>
						<a class="btn btn-ghost" href="#how">See how it flies</a>
					</div>
				</div>
			</section>

			<!-- Steps -->
			<section class="section" id="how">
				<p class="kicker" data-reveal>How it flies</p>
				<h2 data-reveal>Three steps from words to autopilot</h2>
				<div class="steps" data-reveal data-route>
					<svg class="route" viewBox="0 0 1000 140" aria-hidden="true">
						<path id="steps-route" class="route-trail" d="M 30 92 C 190 40, 330 135, 520 96 S 820 96, 975 18" pathLength="1" />
						<g class="route-jet">
							<animateMotion id="steps-fly" dur="2.6s" begin="indefinite" fill="freeze" rotate="auto" keyPoints="0;1" keyTimes="0;1" calcMode="spline" keySplines="0.4 0 0.2 1">
								<mpath href="#steps-route" />
							</animateMotion>
							<g transform="scale(1.4)"><path d={JET} /></g>
						</g>
					</svg>
					{
						steps.map((s, i) => (
							<article class="step" style={`--d: ${0.25 + i * 0.35}s`}>
								<span class="step-n">{s.n}</span>
								<h3>{s.title}</h3>
								<p>{s.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<!-- Diagram -->
			<section class="section">
				<p class="kicker" data-reveal>Under the hood</p>
				<h2 data-reveal>AI while you write. Autopilot when you run.</h2>
				<div class="diagram" data-reveal>
					<svg viewBox="0 44 900 212" role="img" aria-label="You describe the test; Testpilot's AI agent saves the steps; cloud browsers or Testpilot Desktop replay them against your app without AI">
						{
							flights.map((f) => (
								<>
									<path id={f.id} d={f.d} class="flow" />
									<g class="flow-jet">
										<animateMotion dur="2.4s" begin={`${f.delay}s`} repeatCount="indefinite" rotate="auto">
											<mpath href={`#${f.id}`} />
										</animateMotion>
										<animate attributeName="opacity" dur="2.4s" begin={`${f.delay}s`} repeatCount="indefinite" values="0;1;1;0" keyTimes="0;0.15;0.8;1" />
										<g transform="scale(0.55)"><path d={JET} /></g>
									</g>
								</>
							))
						}
						<text x="201" y="140" class="d-label" text-anchor="middle">plain words</text>
						<text x="519" y="155" class="d-label" text-anchor="middle">saved steps,</text>
						<text x="519" y="170" class="d-label" text-anchor="middle">no AI</text>
						{
							boxes.map((b) => (
								<g>
									<rect x={b.x} y={b.y} width={b.w} height={b.h} rx="14" class="d-box" />
									<text x={b.x + b.w / 2} y={b.y + b.h / 2 - 3} class="d-title" text-anchor="middle">{b.title}</text>
									<text x={b.x + b.w / 2} y={b.y + b.h / 2 + 17} class="d-sub" text-anchor="middle">{b.sub}</text>
								</g>
							))
						}
						<rect x="242" y="70" width="230" height="160" rx="16" class="d-core" />
						<g transform="translate(262 88) scale(0.68) translate(-3.5 3.6)">
							<path d={TICK} class="m-tick" />
							<path d={JET} class="m-jet" transform={JET_AT_REST} />
						</g>
						<text x="300" y="111" class="d-core-title">Testpilot</text>
						<text x="262" y="148" class="d-sub">The AI agent drives a real browser</text>
						<text x="262" y="166" class="d-sub">and saves every action as a step.</text>
						<rect x="262" y="186" width="150" height="26" rx="13" class="d-pill" />
						<text x="337" y="203" class="d-pill-text" text-anchor="middle">AI only while writing</text>
					</svg>
				</div>
			</section>

			<!-- Comparison -->
			<section class="section">
				<p class="kicker" data-reveal>Why it matters</p>
				<h2 data-reveal>AI where it helps, not on every run</h2>
				<div class="compare" data-reveal role="table" aria-label="Testpilot compared with hand-written scripts and AI on every step">
					<div class="c-row c-head" role="row">
						<span role="columnheader"></span>
						<span role="columnheader">Hand-written scripts</span>
						<span role="columnheader">AI on every step</span>
						<span role="columnheader" class="c-win">Testpilot <em>Best of both</em></span>
					</div>
					{
						rows.map((r, i) => (
							<div class="c-row" role="row">
								<span role="rowheader">{r.label}</span>
								{r.v.map((ok, j) => (
									<span role="cell" class={j === 2 ? 'c-win' : ''} aria-label={ok ? 'Yes' : 'No'}>
										{ok ? (
											<svg class="c-tick" viewBox="2.5 9.5 32 32" width="24" height="24" style={`--d: ${0.2 + i * 0.12 + j * 0.05}s`} aria-hidden="true">
												<path d={TICK} />
											</svg>
										) : (
											<svg class="c-cross" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
												<path d="M6 6 L18 18 M18 6 L6 18" />
											</svg>
										)}
									</span>
								))}
							</div>
						))
					}
				</div>
			</section>

			<!-- Features -->
			<section class="section" id="why">
				<p class="kicker" data-reveal>Why Testpilot</p>
				<h2 data-reveal>Everything on board</h2>
				<div class="features">
					{
						features.map((f, i) => (
							<article class="feature" data-reveal style={`--d: ${(i % 3) * 0.08}s`}>
								<span class="f-icon">
									<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" set:html={icons[f.icon]} />
								</span>
								<h3>{f.title}</h3>
								<p>{f.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<!-- Final call to action -->
			<section class="final" data-reveal>
				<svg class="final-trail" viewBox="0 0 1200 200" preserveAspectRatio="none" aria-hidden="true">
					<path d="M -20 170 C 300 160, 600 120, 1220 20" />
				</svg>
				<h2>Ready for take-off?</h2>
				<p>Run Testpilot on your machine in a few minutes, then write your first test by chatting.</p>
				<div class="cta">
					<a class="btn btn-primary takeoff" href={docs('getting-started')}>
						Get started
						<svg viewBox="-12 -12 24 24" width="18" height="18" aria-hidden="true"><path d={JET} /></svg>
					</a>
					<a class="btn btn-ghost" href={docs('test-machine-setup')}>Set up a test machine</a>
				</div>
			</section>
		</main>

		<footer class="foot">
			<a class="brand" href={`${base}/`}>
				<svg viewBox={MARK_VIEWBOX} width="22" height="22" aria-hidden="true">
					<path d={TICK} class="m-tick" />
					<path d={JET} class="m-jet" transform={JET_AT_REST} />
				</svg>
				<span>Testpilot</span>
			</a>
			<nav aria-label="Documentation">
				<a href={docs('how-it-works')}>How it works</a>
				<a href={docs('getting-started')}>Getting started</a>
				<a href={docs('using-testpilot')}>Using Testpilot</a>
				<a href={docs('test-machine-setup')}>Test machine setup</a>
			</nav>
		</footer>

		<script>
			// Reveal sections as they scroll in; the steps route also launches its jet once.
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
			if (reduce || !('IntersectionObserver' in window)) {
				items.forEach((el) => el.classList.add('in'));
			} else {
				const io = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (!e.isIntersecting) continue;
							const el = e.target as HTMLElement;
							el.classList.add('in');
							if (el.hasAttribute('data-route')) {
								const fly = el.querySelector('#steps-fly') as SVGAnimationElement | null;
								setTimeout(() => fly?.beginElement(), 250);
							}
							io.unobserve(el);
						}
					},
					{ threshold: 0.25 },
				);
				items.forEach((el) => io.observe(el));
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg: #08080a;
		--surface: #111115;
		--surface-2: #16161b;
		--border: #24242b;
		--border-strong: #34343c;
		--text: #ededef;
		--text-2: #c8c8ce;
		--muted: #9898a2;
		--brand: #5e6ad2;
		--brand-hi: #8b93ec;
		--brand-soft: rgba(94, 106, 210, 0.14);
		color-scheme: dark;
	}
	* {
		box-sizing: border-box;
	}
	html {
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		background: var(--bg);
		color: var(--text);
		font-family: Geist, system-ui, sans-serif;
		-webkit-font-smoothing: antialiased;
		overflow-x: hidden;
	}
	a {
		color: inherit;
	}
	.m-tick {
		fill: var(--text);
		stroke: var(--text);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.m-jet {
		fill: var(--brand-hi);
		stroke: var(--brand-hi);
		stroke-width: 0.8;
		stroke-linejoin: round;
	}

	/* Nav */
	.nav {
		position: sticky;
		top: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 14px max(16px, calc((100vw - 1120px) / 2));
		background: rgba(8, 8, 10, 0.72);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		font-weight: 650;
		font-size: 17px;
		letter-spacing: -0.02em;
	}
	.nav nav {
		display: flex;
		align-items: center;
		gap: 22px;
		font-size: 14px;
	}
	.nav nav a:not(.btn) {
		color: var(--muted);
		text-decoration: none;
		transition: color 0.15s;
	}
	.nav nav a:not(.btn):hover {
		color: var(--text);
	}

	/* Buttons */
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		height: 46px;
		padding: 0 22px;
		border-radius: 10px;
		font-size: 15px;
		font-weight: 600;
		text-decoration: none;
		transition: transform 0.15s, background 0.15s, border-color 0.15s, box-shadow 0.2s;
	}
	.btn-small {
		height: 34px;
		padding: 0 14px;
		font-size: 13.5px;
		background: var(--brand);
		color: #fff;
	}
	.btn-small:hover {
		background: #6d78e0;
	}
	.btn-primary {
		background: var(--brand);
		color: #fff;
		box-shadow: 0 8px 30px rgba(94, 106, 210, 0.35);
	}
	.btn-primary:hover {
		background: #6d78e0;
		transform: translateY(-1px);
		box-shadow: 0 12px 40px rgba(94, 106, 210, 0.5);
	}
	.btn-ghost {
		border: 1px solid var(--border-strong);
		color: var(--text-2);
	}
	.btn-ghost:hover {
		border-color: var(--brand);
		color: var(--text);
	}
	.takeoff svg {
		fill: #fff;
		transform: rotate(-30deg);
		transition: transform 0.2s;
		overflow: visible;
	}
	.takeoff:hover svg {
		animation: takeoff 0.9s ease-in forwards;
	}
	@keyframes takeoff {
		0% {
			transform: rotate(-30deg);
		}
		45% {
			transform: translate(26px, -16px) rotate(-30deg);
			opacity: 0;
		}
		46% {
			transform: translate(-22px, 12px) rotate(-30deg);
			opacity: 0;
		}
		100% {
			transform: rotate(-30deg);
			opacity: 1;
		}
	}

	/* Hero */
	.hero {
		position: relative;
		min-height: calc(100vh - 63px);
		display: grid;
		place-items: center;
		padding: 72px 16px 96px;
		overflow: hidden;
		isolation: isolate;
	}
	.hero-grid {
		position: absolute;
		inset: 0;
		z-index: -2;
		background-image: linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
		background-size: 56px 56px;
		mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 30%, transparent 75%);
	}
	.hero-glow {
		position: absolute;
		z-index: -1;
		width: 760px;
		height: 760px;
		left: 50%;
		top: 38%;
		transform: translate(-50%, -50%);
		background: radial-gradient(circle, rgba(94, 106, 210, 0.28), transparent 62%);
		filter: blur(20px);
		animation: breathe 7s ease-in-out infinite;
	}
	@keyframes breathe {
		50% {
			opacity: 0.65;
			transform: translate(-50%, -50%) scale(1.08);
		}
	}
	.sky {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
	}
	.sky-trail {
		fill: none;
		stroke: var(--brand-hi);
		stroke-opacity: 0.28;
		stroke-width: 2;
		stroke-dasharray: 2 12;
		stroke-linecap: round;
		animation: flow 1.6s linear infinite;
	}
	.sky-jet path {
		fill: var(--brand-hi);
		opacity: 0.55;
	}
	@keyframes flow {
		to {
			stroke-dashoffset: -14;
		}
	}
	.hero-inner {
		max-width: 860px;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.hero-mark {
		margin-bottom: 18px;
		filter: drop-shadow(0 10px 40px rgba(94, 106, 210, 0.35));
	}
	.h-trail {
		fill: none;
		stroke: #fff;
		stroke-width: 12;
